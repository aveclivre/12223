<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>지뢰찾기 (Minesweeper)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --bg-color: #f0f2f5;
            --cell-size: 30px;
            --cell-bg: #c6c6c6;
            --cell-revealed: #e0e0e0;
            --border-light: #ffffff;
            --border-dark: #7b7b7b;
        }

        body {
            background-color: var(--bg-color);
            user-select: none;
            touch-action: manipulation;
        }

        .board {
            display: grid;
            background-color: var(--border-dark);
            border: 3px solid var(--border-dark);
            gap: 1px;
            margin: 0 auto;
        }

        .cell {
            width: var(--cell-size);
            height: var(--cell-size);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            cursor: pointer;
            background-color: var(--cell-bg);
            border: 2px aria-raised;
            box-shadow: inset 2px 2px var(--border-light), inset -2px -2px var(--border-dark);
        }

        .cell.revealed {
            background-color: var(--cell-revealed);
            box-shadow: none;
            border: 0.5px solid #bbb;
        }

        .cell.mine {
            background-color: #ff4d4d;
        }

        .cell.flagged {
            color: #d11;
        }

        .num-1 { color: #0000ff; }
        .num-2 { color: #008000; }
        .num-3 { color: #ff0000; }
        .num-4 { color: #000080; }
        .num-5 { color: #800000; }
        .num-6 { color: #008080; }
        .num-7 { color: #000000; }
        .num-8 { color: #808080; }

        .status-bar {
            background-color: #bdbdbd;
            border: 3px solid;
            border-color: var(--border-dark) var(--border-light) var(--border-light) var(--border-dark);
            padding: 10px;
        }

        .lcd-display {
            background-color: #000;
            color: #ff0000;
            font-family: 'Courier New', Courier, monospace;
            padding: 2px 5px;
            font-size: 20px;
            min-width: 50px;
            text-align: center;
        }

        .emoji-btn {
            font-size: 24px;
            cursor: pointer;
            padding: 0 10px;
            background: var(--cell-bg);
            border: 2px solid;
            border-color: var(--border-light) var(--border-dark) var(--border-dark) var(--border-light);
        }

        .emoji-btn:active {
            border-color: var(--border-dark) var(--border-light) var(--border-light) var(--border-dark);
        }
    </style>
</head>
<body class="flex items-center justify-center min-h-screen">

    <div class="p-4 bg-gray-300 rounded shadow-2xl border-4 border-gray-400">
        <div class="mb-4 flex justify-center gap-2">
            <button onclick="startGame('easy')" class="px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm">초급</button>
            <button onclick="startGame('medium')" class="px-3 py-1 bg-green-500 text-white rounded hover:bg-green-600 text-sm">중급</button>
            <button onclick="startGame('hard')" class="px-3 py-1 bg-red-500 text-white rounded hover:bg-red-600 text-sm">고급</button>
        </div>

        <div class="status-bar flex justify-between items-center mb-2">
            <div id="mine-count" class="lcd-display">010</div>
            <div id="reset-btn" class="emoji-btn" onclick="resetCurrentGame()">😊</div>
            <div id="timer" class="lcd-display">000</div>
        </div>

        <div id="board" class="board"></div>

        <div class="mt-4 text-xs text-gray-600 text-center">
            왼쪽 클릭: 타일 열기 | 오른쪽 클릭: 깃발 꽂기
        </div>
    </div>

    <script>
        const CONFIGS = {
            easy: { rows: 9, cols: 9, mines: 10 },
            medium: { rows: 16, cols: 16, mines: 40 },
            hard: { rows: 16, cols: 30, mines: 99 }
        };

        let currentDifficulty = 'easy';
        let board = [];
        let revealedCount = 0;
        let flagsUsed = 0;
        let timer = 0;
        let timerInterval = null;
        let isGameOver = false;
        let isFirstClick = true;

        const boardElement = document.getElementById('board');
        const mineCountDisplay = document.getElementById('mine-count');
        const timerDisplay = document.getElementById('timer');
        const resetBtn = document.getElementById('reset-btn');

        function startGame(difficulty) {
            currentDifficulty = difficulty;
            const config = CONFIGS[difficulty];
            
            // 초기화
            clearInterval(timerInterval);
            timer = 0;
            timerDisplay.textContent = '000';
            isGameOver = false;
            isFirstClick = true;
            revealedCount = 0;
            flagsUsed = 0;
            resetBtn.textContent = '😊';
            updateMineDisplay();

            // 보드 생성
            boardElement.style.gridTemplateColumns = `repeat(${config.cols}, var(--cell-size))`;
            boardElement.innerHTML = '';
            board = [];

            for (let r = 0; r < config.rows; r++) {
                board[r] = [];
                for (let c = 0; c < config.cols; c++) {
                    const cell = {
                        r, c,
                        isMine: false,
                        isRevealed: false,
                        isFlagged: false,
                        neighborMines: 0,
                        element: document.createElement('div')
                    };
                    cell.element.classList.add('cell');
                    cell.element.addEventListener('click', () => handleCellClick(r, c));
                    cell.element.addEventListener('contextmenu', (e) => {
                        e.preventDefault();
                        handleCellRightClick(r, c);
                    });
                    boardElement.appendChild(cell.element);
                    board[r][c] = cell;
                }
            }
        }

        function resetCurrentGame() {
            startGame(currentDifficulty);
        }

        function placeMines(firstR, firstC) {
            const config = CONFIGS[currentDifficulty];
            let minesPlaced = 0;
            while (minesPlaced < config.mines) {
                const r = Math.floor(Math.random() * config.rows);
                const c = Math.floor(Math.random() * config.cols);
                
                // 첫 클릭 위치와 그 주변 8칸에는 지뢰를 배치하지 않음 (Safety first)
                if (!board[r][c].isMine && (Math.abs(r - firstR) > 1 || Math.abs(c - firstC) > 1)) {
                    board[r][c].isMine = true;
                    minesPlaced++;
                }
            }

            // 인접 지뢰 숫자 계산
            for (let r = 0; r < config.rows; r++) {
                for (let c = 0; c < config.cols; c++) {
                    if (!board[r][c].isMine) {
                        board[r][c].neighborMines = countNeighborMines(r, c);
                    }
                }
            }
        }

        function countNeighborMines(r, c) {
            let count = 0;
            for (let dr = -1; dr <= 1; dr++) {
                for (let dc = -1; dc <= 1; dc++) {
                    const nr = r + dr;
                    const nc = c + dc;
                    if (isValid(nr, nc) && board[nr][nc].isMine) count++;
                }
            }
            return count;
        }

        function isValid(r, c) {
            const config = CONFIGS[currentDifficulty];
            return r >= 0 && r < config.rows && c >= 0 && c < config.cols;
        }

        function handleCellClick(r, c) {
            if (isGameOver || board[r][c].isRevealed || board[r][c].isFlagged) return;

            if (isFirstClick) {
                isFirstClick = false;
                placeMines(r, c);
                startTimer();
            }

            revealCell(r, c);
        }

        function handleCellRightClick(r, c) {
            if (isGameOver || board[r][c].isRevealed) return;

            const cell = board[r][c];
            cell.isFlagged = !cell.isFlagged;
            cell.element.classList.toggle('flagged');
            cell.element.textContent = cell.isFlagged ? '🚩' : '';
            
            flagsUsed += cell.isFlagged ? 1 : -1;
            updateMineDisplay();
        }

        function revealCell(r, c) {
            const cell = board[r][c];
            if (cell.isRevealed || cell.isFlagged) return;

            cell.isRevealed = true;
            cell.element.classList.add('revealed');
            revealedCount++;

            if (cell.isMine) {
                gameOver(false);
                cell.element.classList.add('mine');
                cell.element.textContent = '💣';
                return;
            }

            if (cell.neighborMines > 0) {
                cell.element.textContent = cell.neighborMines;
                cell.element.classList.add(`num-${cell.neighborMines}`);
            } else {
                // 인접 지뢰가 0이면 주변 확장
                for (let dr = -1; dr <= 1; dr++) {
                    for (let dc = -1; dc <= 1; dc++) {
                        if (isValid(r + dr, c + dc)) revealCell(r + dr, c + dc);
                    }
                }
            }

            checkWin();
        }

        function checkWin() {
            const config = CONFIGS[currentDifficulty];
            if (revealedCount === config.rows * config.cols - config.mines) {
                gameOver(true);
            }
        }

        function gameOver(win) {
            isGameOver = true;
            clearInterval(timerInterval);
            resetBtn.textContent = win ? '😎' : '😵';

            // 지뢰 위치 공개
            for (let r = 0; r < board.length; r++) {
                for (let c = 0; c < board[0].length; c++) {
                    if (board[r][c].isMine) {
                        board[r][c].element.textContent = '💣';
                        if (!win) board[r][c].element.classList.add('revealed');
                    }
                }
            }

            if (win) {
                setTimeout(() => alert('축하합니다! 승리하셨습니다!'), 100);
            }
        }

        function startTimer() {
            timerInterval = setInterval(() => {
                timer++;
                if (timer > 999) timer = 999;
                timerDisplay.textContent = timer.toString().padStart(3, '0');
            }, 1000);
        }

        function updateMineDisplay() {
            const config = CONFIGS[currentDifficulty];
            const remaining = config.mines - flagsUsed;
            mineCountDisplay.textContent = Math.max(remaining, -99).toString().padStart(3, '0');
        }

        // 게임 시작
        startGame('easy');

    </script>
</body>
</html>
